{
  "name": "llmwiki-json-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:data && vite build",
    "build:demo": "bun run build:data:demo && vite build",
    "build:data": "cd .. && python3 scripts/llmwiki.py build",
    "build:data:demo": "cd .. && python3 scripts/llmwiki.py build --fixtures",
    "validate": "cd .. && python3 scripts/llmwiki.py validate --fixtures",
    "lint": "cd .. && python3 scripts/llmwiki.py lint --fixtures",
    "test": "cd .. && python3 -m unittest discover -s tests -v && cd viewer && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "watch:data": "bun run scripts/watch-data.ts"
  },
  "dependencies": {
    "@react-sigma/core": "^5.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "lucide-react": "^0.468.0",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.18.0",
    "sigma": "^3.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.171.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
